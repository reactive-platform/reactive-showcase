<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>Enable</Nullable>
    <OutputType>Library</OutputType>
    <LocalRefsDir Condition="Exists('../Refs')">../Refs</LocalRefsDir>
    <BeatSaberDir>$(LocalRefsDir)</BeatSaberDir>
    <AppOutputBase>$(MSBuildProjectDirectory)/</AppOutputBase>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BeatSaber.ViewSystem" Publicize="true">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/BeatSaber.ViewSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SiraUtil">
      <HintPath>$(BeatSaberDir)/Plugins/SiraUtil.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BeatSaberDir)/Libs/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Main" Publicize="true">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Main.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HMLib">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/HMLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HMUI" Publicize="true">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/HMUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="IPA.Loader">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/IPA.Loader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.UIElementsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.VRModule">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.VRModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Zenject">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Zenject.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Zenject-usage">
      <HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Zenject-usage.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="BSML">
      <HintPath>$(BeatSaberDir)/Plugins/BSML.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  
  <PropertyGroup>
    <ReactiveDir>$(MSBuildThisFileDirectory)../../Reactive/src</ReactiveDir>

    <!-- References outside the solution would otherwise always build in Debug, whatever the mod is built in -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ReactiveDir)/Reactive/Reactive.csproj" Private="false" AdditionalProperties="BeatSaberDir=$(BeatSaberDir)" />
    <ProjectReference Include="$(ReactiveDir)/Reactive.Components/Reactive.Components.csproj" Private="false" AdditionalProperties="BeatSaberDir=$(BeatSaberDir)" />
    <ProjectReference Include="$(ReactiveDir)/Reactive.BeatSaber/Reactive.BeatSaber.csproj" Private="false" AdditionalProperties="BeatSaberDir=$(BeatSaberDir)" />

    <!-- Generators and analyzers, used by the compiler rather than referenced -->
    <ProjectReference Include="$(ReactiveDir)/Reactive.Compiler/Reactive.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" AdditionalProperties="BeatSaberDir=$(BeatSaberDir)" />

    <!-- Lets the state generator pre-generate every binding in Debug, so completion can suggest them -->
    <CompilerVisibleProperty Include="Configuration" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks">
      <Version>2.0.0-beta1</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild">
      <Version>0.4.2</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup>
    <None Include="ReactiveShowcase.csproj.user" Condition="Exists('ReactiveShowcase.csproj.user')" />
    <EmbeddedResource Include="manifest.json" />
    <!-- Example sources are compiled and also embedded, so the playground can show them in game -->
    <EmbeddedResource Include="Menu/Examples/Samples/**/*.cs" LogicalName="Examples/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Reactive's projects are in the solution so IDEs restore them, but they don't build there, as they wouldn't get the
    game path. IDEs don't build references either, so they're built from here instead, with the properties above.
  -->
  <Target Name="BuildReactive" BeforeTargets="ResolveProjectReferences" Condition="'$(BuildProjectReferences)' == 'false'">
    <MSBuild Projects="@(ProjectReference)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform);BuildProjectReferences=true" BuildInParallel="true" />
  </Target>
  
</Project>